rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Public handbook access - no authentication required
    match /handbook/TISUK_Handbook_0825.pdf {
      allow read: if true;
      allow write: if false;
    }
  }
}